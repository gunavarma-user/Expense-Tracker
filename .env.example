# Server Configuration
PORT=3000
NODE_ENV=development

# Database path (defaults to ./data/expense_analyzer.db)
DATABASE_PATH=./data/expense_analyzer.db

# ============================================================================
# OPTIONAL EMAIL OTP DELIVERY CONFIGURATION
# Used for: Password recovery ("Forgot Password") and optional email verification in Account Settings.
# Note: Account registration and login do not require OTP.
# Provide either SMTP credentials OR an email API key (Resend / SendGrid).
# ============================================================================

# Option A: Standard SMTP (Gmail, Outlook, Amazon SES, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Expense Analyzer <noreply@expenseanalyzer.local>"

# Option B: Transactional Email API (Alternative to SMTP)
# RESEND_API_KEY=re_123456789
# SENDGRID_API_KEY=SG.123456789

# ============================================================================
# MOBILE SMS OTP DELIVERY CONFIGURATION (Twilio)
# Twilio Account SID, Auth Token, and Twilio phone number (in E.164 format, e.g. +1234567890).
# If not configured, registration/recovery via mobile will return a clear configuration error.
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
